{
  "extends": ["react-app", "airbnb", "plugin:react/recommended", "plugin:prettier/recommended"],
  "plugins": ["react"],
  "env": {"browser": true, "node": true, "es2021": true},
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-console": "off",
    "import/prefer-default-export": "off"
  }
}
